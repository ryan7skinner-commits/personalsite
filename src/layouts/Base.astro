---
import { ClientRouter } from 'astro:transitions';
import BaseHead from '../components/BaseHead.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import SectionBar from '../components/SectionBar.astro';

// `wall` renders the page full-bleed with no sidebar: the homepage is its own navigation.
interface Props { title?: string; description?: string; wall?: boolean; }
const { title, description, wall = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <ClientRouter />
  </head>
  <body>
    {wall ? <slot /> : (
      <>
        <Sidebar />
        <div class="page">
          <main>
            <SectionBar />
            <div transition:animate="slide"><slot /></div>
          </main>
          <Footer />
        </div>
      </>
    )}
  </body>
</html>
<style>
  .page { margin-left: var(--sidebar); min-height: 100vh; display: flex; flex-direction: column; overflow-x: clip; }
  main { flex: 1; width: 100%; max-width: 66rem; padding: 1.25rem clamp(1.25rem, 5vw, 4.5rem) 2rem; }
  @media (max-width: 899px) {
    .page { margin-left: 0; }
  }
</style>
