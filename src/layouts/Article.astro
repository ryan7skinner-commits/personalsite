---
import Base from './Base.astro';
import { formatDate } from '../utils';

interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  tags?: string[];
  eyebrow?: string;
  meta?: { label: string; value: string }[];
}
const { title, description, date, updated, tags = [], eyebrow, meta = [] } = Astro.props;
---
<Base title={title} description={description}>
  <article>
    <header class="head">
      {eyebrow && <p class="small muted eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <p class="muted lede">{description}</p>
      <p class="small muted">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && <span> · updated {formatDate(updated)}</span>}
      </p>
      {meta.length > 0 && (
        <dl class="meta small">
          {meta.map((m) => (<div><dt class="muted">{m.label}</dt><dd>{m.value}</dd></div>))}
        </dl>
      )}
      {tags.length > 0 && <p>{tags.map((t) => <span class="tag">{t}</span>)}</p>}
    </header>
    <div class="prose"><slot /></div>
  </article>
</Base>
<style>
  .head { margin: 1rem 0 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border); }
  .eyebrow { text-transform: uppercase; letter-spacing: 0.06em; margin: 0 0 0.5rem; }
  .lede { font-size: 1.1rem; margin: 0 0 0.75rem; }
  .meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 0.75rem; margin: 1rem 0; }
  .meta dt { font-size: 0.8rem; }
  .meta dd { margin: 0; }
</style>
