---
import { SITE_TITLE } from '../consts';
const nav = [
  { href: '/about/', label: 'About' },
  { href: '/writing/', label: 'Writing' },
  { href: '/work/', label: 'Work' },
];
const path = Astro.url.pathname;
---
<header class="container">
  <a class="brand" href="/">{SITE_TITLE}</a>
  <nav>
    {nav.map((item) => (
      <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>
</header>
<style>
  header { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding-top: 1.5rem; padding-bottom: 1.5rem; flex-wrap: wrap; }
  .brand { font-weight: 700; color: var(--text); text-decoration: none; }
  nav { display: flex; gap: 1.25rem; }
  nav a { color: var(--muted); text-decoration: none; }
  nav a:hover, nav a[aria-current='page'] { color: var(--text); }
</style>
