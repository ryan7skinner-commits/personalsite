---
import { SITE_TITLE } from '../consts';
const year = new Date().getFullYear();
---
<footer>
  <p class="big">Let's make something <span class="hl">good.</span></p>
  <p class="eyebrow">© {year} {SITE_TITLE} · Built with Astro, hosted on Cloudflare</p>
</footer>
<style>
  footer { margin-top: 5rem; padding: 3rem clamp(1.25rem, 5vw, 4.5rem) 2rem; border-top: 3px solid var(--line); }
  .big { font: 800 clamp(2rem, 5vw, 3.6rem)/1 var(--display); letter-spacing: -0.035em; font-variation-settings: 'opsz' 96, 'wdth' 85; margin: 0 0 2rem; }
</style>
