---
import { LINKS, SITE_TITLE } from '../consts';
const year = new Date().getFullYear();
---
<footer class="container small muted">
  <span>© {year} {SITE_TITLE}</span>
  <span class="links">
    <a href={LINKS.email}>Email</a>
    <a href={LINKS.linkedin}>LinkedIn</a>
    <a href={LINKS.github}>GitHub</a>
    <a href="/rss.xml">RSS</a>
  </span>
</footer>
<style>
  footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; margin-top: 4rem; padding-top: 1.5rem; padding-bottom: 2rem; border-top: 1px solid var(--border); }
  .links { display: flex; gap: 1rem; }
  .links a { color: var(--muted); }
</style>
