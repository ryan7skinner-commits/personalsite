---
import { LINKS, SITE_TITLE, NOW } from '../consts';
import { NAV, activeIndex } from '../nav';

const active = activeIndex(Astro.url.pathname);
---
<aside class="sidebar" transition:persist="sidebar">
  <div class="top">
    <a class="brand" href="/" aria-label={`${SITE_TITLE}, home`}>
      <svg class="badge" viewBox="0 0 100 100" aria-hidden="true">
        <defs><path id="ring" d="M50,50 m-38,0 a38,38 0 1,1 76,0 a38,38 0 1,1 -76,0" /></defs>
        <text><textPath href="#ring">PRODUCT · BUILDER · WRITER · PRODUCT · BUILDER ·</textPath></text>
      </svg>
      <span class="mono">RS</span>
    </a>
    <a class="name" href="/">{SITE_TITLE}<span>Product Manager</span></a>
    <button class="menu-btn" aria-expanded="false" aria-controls="site-nav">
      <span class="sr-only">Menu</span><span class="bars" aria-hidden="true"></span>
    </button>
  </div>

  <nav id="site-nav" aria-label="Main">
    <ol>
      {NAV.map((item, i) => (
        <li>
          <a class={`tile t${i}`} href={item.href} aria-current={i === active ? 'page' : undefined}>
            <span class="num">0{i + 1}</span>
            <span class="dot" aria-hidden="true"></span>
            <span class="label">{item.label}</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>

  <div class="foot">
    <p class="now"><span class="pulse" aria-hidden="true"></span><span><b>Now:</b> {NOW}</span></p>
    <p class="links">
      <a href={LINKS.email}>Email</a>
      <a href={LINKS.linkedin}>LinkedIn</a>
      <a href={LINKS.github}>GitHub</a>
      <a href="/rss.xml">RSS</a>
    </p>
  </div>
</aside>

<script>
  import { activeIndex } from '../nav';

  // The sidebar persists across page navigations, so the active tile is
  // updated here and the CSS transitions animate the expand/collapse.
  function sync() {
    const i = activeIndex(location.pathname);
    document.querySelectorAll<HTMLAnchorElement>('.sidebar .tile').forEach((a, j) => {
      if (j === i) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
  }

  function setMenu(open: boolean) {
    document.querySelector('.sidebar')?.classList.toggle('open', open);
    document.querySelector('.menu-btn')?.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
  }

  document.querySelector('.menu-btn')?.addEventListener('click', () => {
    setMenu(!document.querySelector('.sidebar')?.classList.contains('open'));
  });
  document.addEventListener('astro:page-load', () => { sync(); setMenu(false); });
</script>

<style>
  .sidebar {
    --fg: var(--blue);
    position: fixed; inset: 0 auto 0 0; width: var(--sidebar); z-index: 10;
    display: flex; flex-direction: column; gap: 1.25rem;
    padding: 1.25rem; background: var(--cherry); color: var(--fg);
    view-transition-name: sidebar;
  }
  /* Show the live sidebar during page transitions so the tile animation isn't crossfaded. */
  :global(::view-transition-group(sidebar)),
  :global(::view-transition-new(sidebar)) { animation: none; }
  :global(::view-transition-old(sidebar)) { animation: none; opacity: 0; }
  /* Coming from (or going back to) the homepage wall, which has no sidebar: slide it in and out. */
  :global(::view-transition-new(sidebar):only-child) { animation: sidebar-in 0.65s cubic-bezier(.7,0,.2,1); }
  :global(::view-transition-old(sidebar):only-child) { animation: sidebar-in 0.5s cubic-bezier(.7,0,.2,1) reverse; opacity: 1; }
  @keyframes sidebar-in { from { transform: translateX(-100%); } }
  .top { display: flex; align-items: center; gap: 0.8rem; }
  .brand { position: relative; flex: none; display: grid; place-items: center; width: 4.75rem; height: 4.75rem; text-decoration: none; color: var(--fg); }
  .badge { position: absolute; inset: 0; width: 100%; height: 100%; animation: spin 18s linear infinite; fill: var(--fg); font: 600 9.5px var(--mono); letter-spacing: 0.08em; }
  .brand:hover .badge { animation-duration: 4s; fill: var(--tangerine); }
  .brand .mono { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 50%; background: var(--tangerine); color: var(--cherry); font: 800 1rem var(--display); letter-spacing: -0.04em; transition: transform 0.3s; }
  .brand:hover .mono { transform: rotate(-12deg) scale(1.08); }
  @keyframes spin { to { transform: rotate(360deg); } }
  .name { font: 800 1.3rem/1 var(--display); letter-spacing: -0.03em; text-decoration: none; color: var(--fg); }
  .name span { display: block; margin-top: 0.35rem; font: 500 0.66rem var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--tangerine); }

  /* Expanding tiles */
  nav { flex: 1; min-height: 0; }
  nav ol { list-style: none; margin: 0; padding: 0; height: 100%; display: flex; flex-direction: column; gap: 0.6rem; }
  nav li { display: flex; flex: 1 1 0; min-height: 4.25rem; transition: flex-grow 0.7s cubic-bezier(.7,0,.2,1); }
  nav li:has([aria-current='page']) { flex-grow: 5.5; }
  nav li:not(:has([aria-current='page'])):hover { flex-grow: 1.6; }

  .tile {
    --tile-bg: var(--tangerine); --tile-fg: var(--cherry);
    position: relative; flex: 1; display: flex; flex-direction: column; justify-content: space-between;
    padding: 0.85rem 1rem; border-radius: 16px; overflow: hidden;
    background: var(--tile-bg); color: var(--tile-fg); text-decoration: none;
    transition: transform 0.3s cubic-bezier(.3,1.6,.5,1);
  }
  .t1 { --tile-bg: var(--blue); }
  .t2 { --tile-bg: #ffffff; }
  .t3 { --tile-bg: #8e2f2a; --tile-fg: var(--blue); }
  .tile:hover { transform: translateX(4px); }
  .tile[aria-current='page']:hover { transform: none; }
  .num { font: 600 0.72rem var(--mono); letter-spacing: 0.06em; }
  .label {
    font: 800 1.3rem/0.95 var(--display); letter-spacing: -0.035em; font-variation-settings: 'opsz' 96, 'wdth' 85;
    transform-origin: left bottom; transition: font-size 0.7s cubic-bezier(.7,0,.2,1);
  }
  [aria-current='page'] .label { font-size: 3.1rem; }
  .dot {
    position: absolute; top: 0.95rem; right: 1rem; width: 0.55rem; height: 0.55rem; border-radius: 50%;
    background: currentColor; transform: scale(0); transition: transform 0.4s 0.3s;
  }
  [aria-current='page'] .dot { transform: scale(1); }
  .arrow { position: absolute; right: 0.9rem; bottom: 0.7rem; font-size: 1.2rem; opacity: 0; transform: translate(-6px, 6px); transition: 0.25s; }
  .tile:not([aria-current='page']):hover .arrow { opacity: 1; transform: none; }

  .foot { font-size: 0.82rem; }
  .now { display: flex; gap: 0.6rem; align-items: baseline; margin: 0 0 0.9rem; line-height: 1.4; }
  .pulse { flex: none; width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--tangerine); animation: pulse 2s infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 var(--tangerine); } 70%, 100% { box-shadow: 0 0 0 0.6rem transparent; } }
  .links { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; margin: 0; font-family: var(--mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; }
  .links a { color: var(--fg); }
  .menu-btn { display: none; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  @media (max-height: 640px) and (min-width: 900px) {
    .foot .now { display: none; }
    nav li { min-height: 3.25rem; }
  }

  @media (max-width: 899px) {
    .sidebar { position: sticky; top: 0; width: auto; inset: auto; padding: 0.6rem 1rem; gap: 0; border-bottom: 3px solid var(--tangerine); }
    .brand { width: 3.5rem; height: 3.5rem; }
    .brand .mono { width: 1.9rem; height: 1.9rem; font-size: 0.8rem; }
    .badge { font-size: 9px; }
    .menu-btn {
      margin-left: auto; display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 50%;
      background: var(--tangerine); border: 0; cursor: pointer;
    }
    .bars, .bars::before, .bars::after { display: block; width: 1.2rem; height: 2.5px; background: var(--cherry); border-radius: 2px; transition: 0.25s; }
    .bars { position: relative; }
    .bars::before, .bars::after { content: ''; position: absolute; left: 0; }
    .bars::before { top: -6px; } .bars::after { top: 6px; }
    .open .bars { background: transparent; }
    .open .bars::before { top: 0; transform: rotate(45deg); }
    .open .bars::after { top: 0; transform: rotate(-45deg); }
    nav, .foot { display: none; }
    .sidebar.open { position: fixed; inset: 0; gap: 1.25rem; padding-bottom: 1.25rem; border-bottom: 0; }
    .open nav, .open .foot { display: block; }
    .open .tile { animation: rise 0.5s cubic-bezier(.2,.9,.3,1.2) backwards; }
    .open li:nth-child(2) .tile { animation-delay: 0.05s; }
    .open li:nth-child(3) .tile { animation-delay: 0.1s; }
    .open li:nth-child(4) .tile { animation-delay: 0.15s; }
    @keyframes rise { from { opacity: 0; transform: translateY(1.5rem); } }
  }
</style>
