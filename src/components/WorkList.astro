---
import type { CollectionEntry } from 'astro:content';
interface Props { items: CollectionEntry<'work'>[]; }
const { items } = Astro.props;
---
<div class="grid">
  {items.map((item, i) => (
    <a class:list={['card', item.data.kind]} href={`/work/${item.id}/`} style={`--tilt:${i % 2 ? 1 : -1}deg`}>
      <span class="chip solid">{item.data.kind === 'personal' ? 'Personal project' : 'Professional'}</span>
      <span class="t">{item.data.title}</span>
      <span class="d">{item.data.summary}</span>
      {item.data.outcome && <span class="outcome"><b>Outcome</b> {item.data.outcome}</span>}
      <span class="go" aria-hidden="true">↗</span>
    </a>
  ))}
</div>
<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); gap: 1.75rem; }
  .card {
    position: relative; display: flex; flex-direction: column; gap: 0.75rem; padding: 1.5rem 1.5rem 1.75rem;
    background: var(--card); border: 3px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow);
    text-decoration: none; transition: transform 0.3s cubic-bezier(.3,1.6,.5,1), box-shadow 0.3s;
  }
  .card.professional { background: var(--cherry); color: var(--blue); }
  .card:hover { transform: translate(-4px, -4px) rotate(var(--tilt)); box-shadow: 10px 10px 0 var(--tangerine); }
  .chip { align-self: flex-start; }
  .t { font: 800 1.85rem/1.02 var(--display); letter-spacing: -0.03em; font-variation-settings: 'opsz' 96, 'wdth' 85; padding-right: 2rem; }
  .d { opacity: 0.85; }
  .outcome { margin-top: auto; padding-top: 0.75rem; border-top: 2px dashed currentColor; font-size: 0.9rem; }
  .outcome b { font: 600 0.7rem var(--mono); text-transform: uppercase; letter-spacing: 0.08em; margin-right: 0.4rem; }
  .go { position: absolute; top: 1.1rem; right: 1.25rem; font-size: 1.6rem; transition: transform 0.3s; }
  .card:hover .go { transform: rotate(45deg); color: var(--tangerine); }
</style>
