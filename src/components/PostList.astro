---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../utils';
interface Props { posts: CollectionEntry<'writing'>[]; }
const { posts } = Astro.props;
---
<ul class="list">
  {posts.map((post) => (
    <li>
      <a class="title" href={`/writing/${post.id}/`}>{post.data.title}</a>
      <p class="muted">{post.data.description}</p>
      <p class="small muted"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></p>
    </li>
  ))}
</ul>
